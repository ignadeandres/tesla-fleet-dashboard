DB_USER=teslauser
DB_PASSWORD=changeme
DB_NAME=tesla_fleet

JWT_SECRET=changeme

TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://YOUR_SUBDOMAIN.yourdomain.com/auth/tesla/callback

PUBLIC_DOMAIN=YOUR_SUBDOMAIN.yourdomain.com
PUBLIC_GRAPHQL_URL=https://YOUR_SUBDOMAIN.yourdomain.com/graphql

# Hard daily ceiling on Tesla Fleet API calls (across all vehicles), regardless of
# polling intervals. Check the free quota on the Fleet API Developer Dashboard's
# Billing and Usage page and set this comfortably under it.
TESLA_MAX_CALLS_PER_DAY=300

# Usable pack capacity, used to turn a battery % delta into kWh for both trip
# consumption and charging sessions. Read by the backend resolver AND the worker —
# they must agree, so keep it here rather than per-service.
BATTERY_CAPACITY_KWH=56

# After the vehicle was last seen driving/charging, the worker polls every 90s
# (instead of every 15 min) for the next 10 minutes, to catch a short follow-up trip
# that would otherwise slip through undetected. This costs roughly +13 billed Fleet
# API calls per trip on top of normal usage. Set to "false" to disable it and go back
# to the flat 15-minute idle interval if you're watching your free-tier quota.
TESLA_FAST_FOLLOW_ENABLED=true
